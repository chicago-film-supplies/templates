<%/* draft draft/quote/cbf24103 */%>
<%
const order = it.doc;
const { destinations, items, totals } = order;
const CHICAGO = it.tz("America/Chicago");
// Divider rows are structure, not stock. They are interleaved with the real
// line items in one array, and `path` records BOTH kinds of ancestor — which is
// why the indent below has to subtract them rather than assume how many there
// are. One predicate, so the two views cannot drift apart.
const isDivider = (i) => i.type === "group" || i.type === "destination";
const lineItems = items.filter(i => !isDivider(i));
const dividerUids = new Set(items.filter(isDivider).map(i => i.uid));

// A `transaction_fee` is stored in `items[]` but is NOT a line of the order.
// `ITEM_CONTRACTS.transaction_fee` in @cfs/core is `pricing: "from_total"`,
// `fulfillable: false`, `replacement: "forbidden"` — it is priced FROM the
// document rather than from a shelf, and nobody ever picks one.
//
// It must not appear in the items grid, because `totals.transaction_fees` is
// DERIVED from these very items (`getTransactionFeeTotals(costTransactionFees(
// items, ...))`), so rendering both puts the same money on the page twice and
// a customer reads it as being charged twice. Measured on `discounts-and-fee`:
// the Card Processing Fee is $14.79 as a line and $14.79 again in the totals.
//
// The totals row is the better of the two survivors — it carries the RATE
// ("Card Processing Fee 2.9%:"), where the line is a degenerate row with an
// empty Type, no unit price and no tax. And the fee is genuinely outside the
// line-item arithmetic: `totals.subtotal_cents` excludes it, and
// `total_cents` adds it only at the end, after tax.
//
// Consequence worth knowing: the Total column no longer sums to
// `totals.total_cents` — it sums to `subtotal_discounted + tax`, and the totals
// block adds the fee on top. That is the ordinary shape of a quote.
const isDocumentFee = (i) => i.type === "transaction_fee";
const shownItems = items.filter(i => !isDocumentFee(i));
const shownLineItems = lineItems.filter(i => !isDocumentFee(i));
const hasDiscount = it.orders.orderHasDiscount(lineItems);
const hasRentals = it.orders.orderHasRentals(lineItems);
const hasTax = it.orders.orderHasTax(lineItems);

// How many columns the items grid emits: SIX unconditional — Item Description,
// Type, Qty, Unit Price, Subtotal, Total — plus the three conditionals. 6 to 9.
//
// Two things read it and they must not drift apart: the `colspan` on a banner
// row (which has to span its own table exactly), and `--block-3-fraction`
// below, which puts the second alignment edge of the page ON an items column
// boundary rather than at an arbitrary percentage.
const itemColumnCount = 6 + (hasRentals ? 1 : 0) + (hasDiscount ? 1 : 0) + (hasTax ? 1 : 0);

// WHICH boundary: the one NEAREST THE HALF-WAY POINT, rounding left.
//
// #items gives its description column `--label-col` and splits the remainder
// equally between the other n-1 columns, so its interior boundaries sit at
// `--label-col + m x (remainder / (n-1))` for m = 1..n-2. Choosing
// `m = floor((n-1)/2)` picks the one closest to the middle of that remainder,
// which is what keeps the two #destinations address blocks close to equal:
//
//     n=6  m=2  ->  202 / 302      n=8  m=3  ->  216 / 288
//     n=7  m=3  ->  252 / 252      n=9  m=4  ->  252 / 252
//
// The exact halves at 7 and 9 are structural, not luck: n odd means n-1 is
// even, so a boundary lands exactly on the middle. For even n there is none,
// and the two straddling boundaries are equally far off — a genuine tie, broken
// LEFT so the totals block gets the wider half. It needs it: "Subtotal after
// Discount:" is the longest label on the page.
//
// ONE rule, deliberately, rather than a column-count breakpoint. "4th-from-last
// above 8 columns, 3rd-from-last below" produces these exact numbers too (it
// works out to the 3rd from last at 6 and 7, the 4th at 8 and 9) — but it
// states a threshold the layout does not have, and the next person to add a
// conditional column has to rediscover which side of it the new count falls on.
// Nearest-to-half re-derives itself.
const addressBoundary = Math.floor((itemColumnCount - 1) / 2);

// #destinations divides its address area into the SAME n-1 equal columns and
// spans them, so block 3 opens on `--dest-block-3` by construction rather than
// by a width that has to be kept in step with one.
//
// Spans rather than two sized <col>s because a sized <col> cannot express this:
// Blink silently ignores a table column width that mixes a percentage with a
// length, which is what `--dest-block-3 - --label-col` is. See styles/quote.css.
const addressColumnCount = itemColumnCount - 1;
const deliverySpan = addressBoundary;
const returnSpan = addressColumnCount - addressBoundary;
// NON-ZERO, not "present". `replacement_cents` is a field on EVERY priced line
// — schema-required whenever `stock_method !== "none"` — so a sale, a service
// and a `replacement` twin all carry it, and all carry it at 0 because none of
// them has anything to replace. Nothing writes `null`: measured across this
// fixture set, 0 nulls against 38 lines sitting at exactly 0. So `!= null` was
// a no-op and this table listed every priced line — 22 blank rows of 78 on
// `long-multi-group`, 10 of 18 on `mixed-two-tax-rates`, and a heading plus one
// blank row on the three single-line fixtures.
//
// Dropping them moves no money: `long-multi-group` still totals $28,847.87.
// The section says "your rental order", which is the rule this now implements.
//
// It also stopped being merely untidy: the FLAT arm of the tax calculation
// reads the QUANTITY and ignores the subtotal, so once a per-unit levy exists
// (the $0.05/bottle water tax) a $0.00 replacement row carries real money into
// the grand total — 240 bottles is $12.00 of levy on nothing. core#62.
//
// Truthy rather than `> 0`, matching `calculateReplacementTotals` exactly so the
// rows and the footer cannot disagree: a NEGATIVE replacement cost is
// meaningless rather than absent, and is better shown than silently dropped.
const replacementItems = lineItems.filter(i => i.price.replacement_cents);

// Does anything on this quote actually GO anywhere?
//
// A `replacement` line is not a thing we hand to a customer — it is us
// recovering the cost of an item that was lost or damaged while already in
// their possession. So a quote whose every line is a replacement has no
// delivery, no collection, no addresses and no contacts, and #destinations
// blocks 2 and 3 (the two address columns) are describing a movement that never
// happens. They are dropped entirely rather than left empty: a pair of headed
// columns with nothing under them reads as missing data rather than as
// inapplicable.
//
// `shownLineItems`, not `lineItems` — a `transaction_fee` is not a line of the
// order (see the note above), so a card fee riding along on a replacement-only
// quote must not resurrect the address columns.
const hasDeliverableItems = shownLineItems.some(i => i.type !== "replacement");

// The Type column exists for ONE job: a product stocked both for sale and for
// rent needs the column to say which one this line is. The other four members
// of DOC_LINE_ITEM_TYPES — replacement, service, surcharge, transaction_fee —
// answer a question nobody asked, in raw enum spelling, and one of them does
// not fit: `transaction_fee` is a single unbreakable token measured at 71px
// against the 61px the 9-column grid gives the column, so it overflowed its
// cell on `discounts-and-fee`. Diagnosed in the v66 draft recovered on
// 2026-08-14 (branch recovered/quote-12unit-grid-2026-08-12).
const DISAMBIGUATED_ITEM_TYPES = new Set(["rental", "sale"]);

// A quote is read, not reconciled. A column of $0.00 and 0 is noise that hides
// the figures that matter, so a numeric cell renders nothing at all at zero.
//
// NON-ZERO rather than "greater than zero", deliberately. Core lets a flat
// discount exceed its own line, so `subtotal_discounted_cents` is allowed to go
// negative and its sign is load-bearing — a negative is a credit the reader
// must see, and it is the one case where a blank cell would be a lie rather
// than a tidy-up. Both helpers also swallow null, which is what lets the tax
// cell drop its separate existence guard.
//
// GRAND TOTALS ARE DELIBERATELY EXEMPT — the #totals block and the replacement
// footer print their figure at zero, because a total of zero is a fact about
// the quote rather than an absent value.
const numberCell = (n) => n ? n : "";
const moneyCell = (c) => c ? it.money.formatCents(c) : "";

// The tax a line carries, in cents. Factored out because three things need it
// now: the Tax column prints it, the money cells to its LEFT have to know
// whether the row owes anything before they can decide what a zero looks like,
// and the component roll-up below moves it onto another row.
//
// NOT named `lineTaxCents` — the replacement fold further down already binds
// that name in its own scope, and a same-named outer const would shadow-trap
// the next editor who moves either one.
const itemTaxCents = (item) => (item.price.taxes || []).reduce((sum, t) => sum + t.amount_cents, 0);

// A zero money cell on a row that OWES TAX prints an em-dash, not a blank.
//
// The blank-at-zero rule above predates a tax that can charge a $0.00 line. The
// FLAT arm reads the QUANTITY and ignores the subtotal, so a mandatory
// zero-priced component — 240 bottles at $0.05 each — bills $12.00 while its
// unit price and its subtotal are both genuinely $0.00. Under the plain rule
// that row renders as `240 | | | $12.00 | $12.00`: two empty cells beside a
// real charge, which reads as missing data rather than as an answer. An
// em-dash says the value was computed and is nothing, which is the distinction
// a blank cannot make. templates#107.
//
// Row-scoped rather than global, and that is the whole design: on an ordinary
// row a zero unit price sits beside a zero tax and a zero total, and dashing
// those would restore exactly the column of noise the blank rule exists to
// remove. Only a row whose own tax contradicts its blank cells gets one.
const moneyCellOn = (c, taxCents) => c ? it.money.formatCents(c) : (taxCents ? "—" : "");

// How deep a line item is nested UNDER ANOTHER LINE ITEM — 0 for a top-level
// line, 1 for its component, 2 for a component of a component.
//
// This used to be `item.path.length - 3`, which is a proxy for depth rather
// than depth: it hard-codes an assumption that both divider levels
// (destination + group) are always present. When a line sits directly under a
// destination with no group, its path is `[dest, item]` and the formula gives
// −1em — invalid CSS, silently dropped — while ITS component gets 0em and
// renders flush with its parent. That second half is the real defect; the
// negative value was only the visible half.
//
// `path` is non-empty and self-inclusive on every item (the workspace
// items-array invariant), so `at(-1)` is the item itself: drop it, then count
// the ancestors that are real line items. Independent of how many divider
// levels happen to be present. Divider uids are per-order UUIDs and product
// uids are Firestore ids, so the two sets cannot collide.
const componentDepth = (item) =>
  (item.path ?? []).slice(0, -1).filter((uid) => !dividerUids.has(uid)).length;

// ── Declared param: hide_zero_priced_components (default false) ────────────
//
// A mandatory zero-priced component is structure rather than something the
// customer chose — the 240 bottles inside 10 cases of water. Some readers want
// the case and not the bottles, so the row can be hidden.
//
// 🔴 Hiding it must ROLL ITS MONEY ONTO THE PARENT, exactly. The #totals block
// reads the server-computed `totals` on the document, which count the tax on that row
// whether or not it is rendered — so a hidden row whose $12.00 goes nowhere
// makes the items table stop reconciling with its own footer, which is a worse
// document than the one with the extra row in it.
//
// Only a COMPONENT is eligible (`componentDepth > 0`). A top-level zero-priced
// line is something the customer ordered at no charge — the Locations Toolkit
// on `long-multi-group` — and hiding that would delete a line of the order.
const hideZeroPricedComponents = it.params.hide_zero_priced_components === true;

// Keyed by PATH, never by uid: `item.uid` repeats within one document (18% of
// prod orders), so two hidden components can share a uid and their money would
// collide onto one row. `path` is the row identity.
//
// The separator is NUL, BUILT rather than written as a unicode escape. This
// file is authored through `templates_propose_edit`, whose payload is JSON, and
// a JSON round-trip decodes such an escape into a real NUL BYTE in the source.
// The file still behaves identically — a literal NUL inside a JS string
// literal is the same character — but it puts a control byte in a text file
// that git is one edit away from treating as binary, and it mutates a line
// nobody meant to touch. `String.fromCharCode` says the same thing in
// characters that survive the trip.
const PATH_SEP = String.fromCharCode(0);
const pathKey = (item) => (item.path ?? []).join(PATH_SEP);
const hiddenPaths = new Set();
const rolledUp = new Map();
if (hideZeroPricedComponents) {
  const byPath = new Map(lineItems.map(i => [pathKey(i), i]));
  const eligible = lineItems.filter(i => i.zero_priced === true && componentDepth(i) > 0);
  const eligibleKeys = new Set(eligible.map(pathKey));
  eligible.forEach(hidden => {
    // Walk up to the nearest ancestor that is a line item AND is itself still
    // visible, so a component of a hidden component rolls all the way to
    // whatever actually renders.
    let up = (hidden.path ?? []).slice(0, -1);
    while (up.length > 0) {
      const key = up.join(PATH_SEP);
      const ancestor = byPath.get(key);
      if (ancestor && !eligibleKeys.has(key)) {
        const acc = rolledUp.get(key) || { tax: 0, subtotal: 0, total: 0 };
        acc.tax += itemTaxCents(hidden);
        acc.subtotal += hidden.price.subtotal_discounted_cents ?? hidden.price.subtotal_cents;
        acc.total += hidden.price.total_cents;
        rolledUp.set(key, acc);
        hiddenPaths.add(pathKey(hidden));
        return;
      }
      up = up.slice(0, -1);
    }
    // No visible ancestor line item — its parent is a divider, or the tree is
    // shaped in a way this does not model. The row STAYS, because losing the
    // money silently is the one outcome that must not happen. It is absent from
    // `hiddenPaths`, so nothing else has to know.
  });
}
const renderedItems = shownItems.filter(i => !hiddenPaths.has(pathKey(i)));

// Replacement cost, in integer cents, computed the way CORE computes it.
//
// ## The order of operations is the whole point
//
// This used to be round-then-multiply: a per-unit tax
// (`unitCost * t.rate / 100`) accumulated and then scaled by quantity. Core
// does the opposite in `calculateReplacementTotals` — it multiplies the line out
// FIRST and rounds once, at the line. On dollar floats the two mostly agreed
// and the difference read as rounding noise. On integer cents they diverge
// systematically, and the divergence shows up as a PDF footer that disagrees
// with the order it is rendering.
//
// So the grand totals are no longer hand-rolled at all: `it.orders`
// exposes the real function, and calling it is what makes the footer and the
// stored order the same arithmetic rather than two implementations that happen
// to match. `item.price.taxes` is a `PriceModifier[]` carrying `uid`, `rate`
// and `type`, which is exactly the surface the lookup inside it reads.
//
// ⚠️ The PER-LINE columns below still have no exposed helper —
// `computeItemTaxAmountCents` is deliberately denylisted as a building block,
// and there is no stored per-line replacement field. They are therefore spelled
// out here in the same order core uses, so they sum to the totals by construction.
// It is a duplicated formula and is tracked as such; see the note at the table.
//
// NOTE FOR THE NEXT EDITOR: keep apostrophes OUT of this block. Eta scans for
// the closing tag while tracking string delimiters, and it counts a bare
// single-quote as one even inside a line comment — so an odd number of them
// swallows the close tag and the whole template compiles as a runaway string.
// The failure surfaces as a bad-syntax error several hundred lines away from
// the cause, which is why this note is here rather than in a commit message.
const replacementTaxCatalog = lineItems.flatMap(i => i.price.taxes || []);
const rTotals = it.orders.calculateReplacementTotals(lineItems, replacementTaxCatalog);
const rSubtotal = rTotals.subtotal_cents;
const rTax = rTotals.tax_cents;
const rTotal = rTotals.total_cents;

// One replacement line, in the same order and with the same rounding
// core uses — `× n ÷ d`, divide last, round half away from zero exactly once.
// Half AWAY from zero rather than half up because a negative subtotal is legal
// and a credit must not differ in magnitude from the charge it mirrors.
const replacementLine = (item) => {
  const unitCostCents = item.price.replacement_cents;
  const qty = item.quantity || 0;
  const lineSubtotalCents = Math.round(unitCostCents * qty);
  const taxCentsFor = (subtotalCents, quantity) =>
    (item.price.taxes || []).reduce((sum, t) => {
      if (t.type === "percent") {
        const scaled = subtotalCents * t.rate;
        const magnitude = Math.abs(scaled);
        const rounded = Math.floor((2 * magnitude + 100) / 200);
        return sum + (scaled < 0 ? -rounded : rounded);
      }
      // `flat`: DOLLARS per unit. `t.rate` is a rate and keeps its dollar
      // denomination — this is the one place in the template where a money
      // value is not already cents.
      return sum + Math.round(it.money.toCents(t.rate) * quantity);
    }, 0);
  const lineTaxCents = taxCentsFor(lineSubtotalCents, qty);
  // The per-UNIT column is the line divided back down, not a separately-rounded
  // per-unit computation — deriving it the other way is what made the columns
  // fail to add up to their own footer.
  const unitTaxCents = qty > 0 ? Math.round(lineTaxCents / qty) : 0;
  return {
    unitCostCents,
    qty,
    unitTaxCents,
    unitTotalCents: unitCostCents + unitTaxCents,
    lineTaxCents,
    lineTotalCents: lineSubtotalCents + lineTaxCents,
  };
};
%>
<%/* `--block-3-fraction` is emitted here rather than declared in quote.css
     because it depends on the DOCUMENT — how many conditional columns the items
     grid turned on — and CSS cannot see that. Everything that reads
     `--dest-block-3` is inside this element. See styles/quote.css. */%>
<div id="grid-wrapper" style="--block-3-fraction: calc(<%= addressBoundary %> / <%= addressColumnCount %>)">
  <div id="logo">
    <%~ it.logo %>
  </div>
  <section id="bill-to">
    <%
    // `billing_address` is `.optional()` on the organization snapshot AND
    // `Address` is itself `.nullable()`, so an order can legitimately carry
    // neither — the old unguarded chain threw on the first `.street` (#25).
    //
    // The lines are assembled rather than emitted as bare spans for the same
    // reason: a separator only belongs there when both sides of it are present.
    // `street2` defaults to `""`, so the old markup printed a leading comma on
    // every order without a suite number.
    const billing = order.organization?.billing_address ?? {};
    const streetLine = [billing.street, billing.street2].filter(Boolean).join(", ");
    const cityLine = [
      [billing.city, billing.region].filter(Boolean).join(", "),
      billing.postcode,
    ].filter(Boolean).join(" ");
    // `country_name` is stored with a space. Matching "UnitedStates" never
    // matched anything, so the country line printed on every domestic quote.
    const foreign = billing.country_name && billing.country_name !== "United States";
    %>
    <h1>Quote #<%= order.number %></h1>
    <div><%= order.organization.name %></div>
    <% if (streetLine) { %>
    <div><%= streetLine %></div>
    <% } %>
    <% if (cityLine) { %>
    <div><%= cityLine %></div>
    <% } %>
    <% if (foreign) { %>
    <div><%= billing.country_name %></div>
    <% } %>
  </section>
  <section id="cfs">
    <h1>Chicago Film Supplies</h1>
    <div>3100 W Fillmore St, Chicago, IL 60612</div>
    <div>team@chicagofilmsupplies.com</div>
    <div>312.818.3008</div>
  </section>

<table id="details">
  <thead>
    <tr>
      <th scope="col">Date:</th>
      <th scope="col">Subject:</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td><%= it.dateFns.format(it.dateFns.parseISO(it.now), 'MMMM d, yyyy') %></td>
      <%/* An empty cell, not an absent one: under `table-layout: fixed` a short
           row leaves a real trailing gap rather than being absorbed. */%>
      <% if (order.subject) { %>
      <td><%= order.subject %></td>
      <% } else { %>
      <td></td>
      <% } %>
    </tr>
  </tbody>
  <thead>
    <tr>
      <th scope="col">Order Number:</th>
      <th scope="col">Reference:</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td><%= order.number %></td>
      <% if (order.reference) { %>
      <td><%= order.reference %></td>
      <% } else { %>
      <td></td>
      <% } %>
    </tr>
  </tbody>
</table>

<%/* Column widths live on the colgroup — see styles/quote.css. `table-layout:
     fixed` sizes a table from its FIRST ROW, and this table has one
     <thead>/<tbody> pair per destination, so a width on a body cell can never
     take effect. */%>
<%/* The dates block is FOUR columns now, not two: [start] [→] [end] [duration].
     Their widths still sum to `--label-col`, which is what keeps block 2 opening
     on the shared alignment edge — see styles/quote.css. */%>
<table id="destinations"<% if (!hasDeliverableItems) { %> class="dates-only"<% } %>>
  <colgroup>
    <col class="date">
    <col class="arrow">
    <col class="date">
    <col class="days">
    <%/* One <col> per address SUB-column, all auto and therefore all equal —
         the blocks are colspans over them. See styles/quote.css. */%>
    <% if (hasDeliverableItems) { %>
    <% for (let i = 0; i < addressColumnCount; i++) { %>
    <col class="address">
    <% } %>
    <% } %>
  </colgroup>
<% destinations.forEach(function(dest, destIndex) { %>
    <%
    const d = dest.dates || {};
    const legend = it.orders.getDestinationsLegend([dest]);
    const startLabel = legend.start || "Delivery";
    const endLabel = legend.end || "Pickup";
    // Every date boundary on a destination is nullable, so each cell below is
    // gated on the values it actually reads rather than on the destination
    // existing (#25). `d` is that gate, computed once — re-dereferencing
    // `dest.dates.*` at the call site is what made the guard and the read
    // disagree.
    const hasActiveWindow = Boolean(d.delivery_start && d.collection_start);
    const hasChargeWindow = Boolean(d.charge_start && d.charge_end);
    const showCharged = hasChargeWindow && !it.orders.isSameAsDeliveryDates(d);
    // Address lines (no contact — contact rides its own column).
    const addrLines = (ep) => {
      if (!ep || !ep.address) return [];
      const a = ep.address;
      return [
        [a.street, a.street2].filter(Boolean).join(', '),
        [a.city, a.region, a.postcode].filter(Boolean).join(', '),
        (a.country_name && a.country_name !== "United States") ? a.country_name : null,
      ].filter(Boolean);
    };
    const contactLine = (ep) => {
      if (!ep || !ep.contact) return "";
      const phone = ep.contact.phones && ep.contact.phones.length > 0 ? ep.contact.phones[0] : null;
      return [ep.contact.name, phone].filter(Boolean).join(' · ');
    };
    %>
  <thead>
    <tr>
    <th scope="col" colspan="4">Dates: </th>
    <% if (hasDeliverableItems) { %>
    <th scope="col" colspan="<%= deliverySpan %>"><%= startLabel %></th>
    <th scope="col" colspan="<%= returnSpan %>"><%= endLabel %></th>
    <% } %>
    </tr>
  </thead>
  <tbody>
    <tr>
    <td class="date">
      <% if (d.delivery_start) { %>
      <%= it.dateFns.format(it.dateFns.parseISO(d.delivery_start), 'EEE M/d/yy') %>
      <% } %>
    </td>
    <%/* The arrow and the end date are RENTAL furniture. A sale-only order is
         handed over and never comes back, so it has no end of anything — and the
         old hyphenated range printed `Tue 8/11/26 - Tue 8/11/26`, a window one
         day wide that does not exist. Gating both on `hasRentals` states that,
         where the range shape could only imply it.
         The three cells are gated on three different things, which is the point
         of splitting them. The arrow keeps `hasActiveWindow` — it is the only
         one that needs BOTH ends, because it draws the span between them. The
         dates each read their own boundary: every boundary on a destination is
         nullable, and one guard over the whole range used to hide a start date
         we had whenever the end was missing. */%>
    <td class="arrow">
      <% if (hasRentals && hasActiveWindow) { %><%~ it.icons.svg("arrow-right", { size: 9 }) %><% } %>
    </td>
    <td class="date">
      <% if (hasRentals && d.collection_start) { %>
      <%= it.dateFns.format(it.dateFns.parseISO(d.collection_start), 'EEE M/d/yy') %>
      <% } %>
    </td>
    <td>
      <% if (d.days_active != null) { %>
      <%= it.dates.formatChargeDays(d.days_active).periodLabel %>
      <% } %>
    </td>
    <% if (hasDeliverableItems) { %>
    <td class="address" colspan="<%= deliverySpan %>">
      <% addrLines(dest.delivery).forEach((line, i) => { %><% if (i > 0) { %><br><% } %><%= line %><% }) %>
    </td>
    <td class="address" colspan="<%= returnSpan %>">
      <% addrLines(dest.collection).forEach((line, i) => { %><% if (i > 0) { %><br><% } %><%= line %><% }) %>
    </td>
    <% } %>
    </tr>
    <tr>
      <td colspan="4">
      <!-- Charge window — only when it differs from delivery/collection -->
      <% if (showCharged) { %>
      <span class="bold">Dates Charged: </span>
      <% } %>
      </td>
      <% if (hasDeliverableItems) { %>
      <td class="address" colspan="<%= deliverySpan %>"><%= contactLine(dest.delivery) %></td>
      <td class="address" colspan="<%= returnSpan %>"><%= contactLine(dest.collection) %></td>
      <% } %>
    </tr>
    <tr>
      <%/* Split across the same four columns as the active window above, so the
           two ranges read as one stacked pair rather than as two layouts. */%>
      <td class="date">
      <% if (showCharged) { %>
      <%= it.dateFns.format(it.dateFns.parseISO(d.charge_start), 'EEE M/d/yy') %>
      <% } %>
      </td>
      <td class="arrow">
      <% if (showCharged && hasRentals) { %><%~ it.icons.svg("arrow-right", { size: 9 }) %><% } %>
      </td>
      <td class="date">
      <% if (showCharged && hasRentals) { %>
      <%= it.dateFns.format(it.dateFns.parseISO(d.charge_end), 'EEE M/d/yy') %>
      <% } %>
      </td>
      <td>
        <!-- Charge window — only when it differs from delivery/collection -->
        <% if (showCharged && d.days_charged != null) { %>
        <%= it.dates.formatChargeDays(d.days_charged).periodLabel %>
        <% } %>
      </td>
      <% if (hasDeliverableItems) { %>
      <td class="address" colspan="<%= deliverySpan %>"><%= dest.delivery?.instructions ?? "" %></td>
      <td class="address" colspan="<%= returnSpan %>"><%= dest.collection?.instructions ?? "" %></td>
      <% } %>
    </tr>
  </tbody>
<% }) %>
</table>

<!-- Items -->
<%/* `shownLineItems`, not `lineItems`: an order whose only non-divider entry is
     a transaction fee has nothing to put in this grid, and an empty table with
     a header row reads as a rendering fault. */%>
<% if (shownLineItems.length > 0) { %>
<section id="items">
  <table>
    <thead>
      <tr>
        <th scope="col" class="wide">Item Description</th>
        <th scope="col">Type</th>
        <th scope="col">Qty</th>
        <% if (hasRentals) { %>
        <th scope="col">Duration</th>
        <% } %>
        <th scope="col">Unit Price</th>
        <% if (hasDiscount) { %>
        <th scope="col">Discount</th>
        <% } %>
        <th scope="col">Subtotal</th>
        <% if (hasTax) { %>
        <th scope="col">Tax</th>
        <% } %>
        <th scope="col" class="total">Total</th>
      </tr>
    </thead>
    <tbody>
      <%/* The banner spans this table exactly. It is `itemColumnCount` rather
           than a second copy of the arithmetic: the alignment edge of the page
           is derived from the same number, and a banner that disagreed with
           the header would take that edge with it. The base read `5` and every
           banner row spanned one column short of its own table. */%>
      <% const bannerSpan = itemColumnCount; %>
      <% renderedItems.forEach(item => { %>
        <% if (item.type === "group") { %>
        <tr>
          <td class="wide" colspan="<%= bannerSpan %>">
            <strong><%= item.name %></strong>
          </td>
        </tr>
        <% } else if (item.type === "destination") { %>
        <% if (destinations.length > 1) { %>
        <tr>
          <td class="wide" colspan="<%= bannerSpan %>">
            <%= item.name %>
          </td>
        </tr>
        <% } %>
        <% } else { %>
        <%/* The money on the row itself plus anything rolled onto it from a hidden
             zero-priced component. With the param off, `rolled` is undefined
             everywhere and these are the stored figures on the line. */%>
        <% const rolled = rolledUp.get(pathKey(item)); %>
        <% const rowTaxCents = itemTaxCents(item) + (rolled ? rolled.tax : 0); %>
        <% const rowSubtotalCents = (item.price.subtotal_discounted_cents ?? item.price.subtotal_cents) + (rolled ? rolled.subtotal : 0); %>
        <% const rowTotalCents = item.price.total_cents + (rolled ? rolled.total : 0); %>
        <tr>
          <td style="padding-left: <%= componentDepth(item) %>em">
            <%= item.name %>
            <% if (item.description) { %>
            <br><%= item.description %>
            <% } %>
          </td>
          <td class="capitalize"><% if (DISAMBIGUATED_ITEM_TYPES.has(item.type)) { %><%= item.type %><% } %></td>
          <td><%= numberCell(item.quantity) %></td>
          <% if (hasRentals) { %>
          <td><%= item.type === "rental" && item.price.chargeable_days ? item.price.chargeable_days + ' days' : '' %></td>
          <% } %>
          <td><%= moneyCellOn(item.price.base_cents, rowTaxCents) %></td>
          <% if (hasDiscount) { %>
          <td>
            <%/* Parenthesised: a discount is a deduction, and the accounting
                 convention reads it as one without a sign the eye can miss.
                 Both arms get the parens — a `percent` discount is the same
                 deduction expressed as a rate, so bracketing only the flat one
                 would make the column's two shapes look like different kinds
                 of number. Empty cell when there is no discount, NOT `(  )`.

                 Padded inside the brackets — `( 20% )`, not `(20%)`. At the 9px
                 root the glyphs sit tight enough that an unpadded bracket reads
                 as part of the number rather than around it. */%>
            <% if (item.price.discount) { %>
            <% if (item.price.discount.type === "percent") { %>
            <% if (item.price.discount.rate) { %>( <%= item.price.discount.rate %>% )<% } %>
            <% } else { %>
            <% if (item.price.discount.amount_cents) { %>( <%= it.money.formatCents(item.price.discount.amount_cents) %> )<% } %>
            <% } %>
            <% } %>
          </td>
          <% } %>
          <%
            // `??`, not `||`. A fully-discounted line has
            // `subtotal_discounted_cents: 0`, which is falsy — so `||` fell
            // through and printed the PRE-discount subtotal for exactly the
            // lines where the discount mattered most. The bug was invisible
            // because neither fixture carried a discount until templates#57.
          %>
          <td><%= moneyCellOn(rowSubtotalCents, rowTaxCents) %></td>
          <% if (hasTax) { %>
          <%/* The `taxes && taxes.length > 0` guard is gone because `moneyCell`
               subsumes it: an empty array reduces to 0 and renders blank, which
               is the same cell the guard produced. One test, not two. */%>
          <td><%= moneyCell(rowTaxCents) %></td>
          <% } %>
          <td class="total"><%= moneyCell(rowTotalCents) %></td>
        </tr>
        <% } %>
      <% }) %>
    </tbody>
  </table>
</section>
<% } %>

<section id="information">
  <%/* The sentence says "your rental order", and this used to print it on a
       replacement-only quote where both halves were false — no rental, and a
       $0.00 figure. Measured on `replacement-only` (prod order 976): a lost
       Surveillance Kit whose own `replacement_cents` is 0.

       ⚠️ THAT CASE IS NOW HANDLED UPSTREAM. `replacementItems` filters on a
       NON-ZERO replacement value, so the Surveillance Kit no longer enters the
       set and the leading guard alone suppresses the note. This OR is no longer
       doing the job it was written for; the reasoning is kept to explain why it
       is still here rather than deleted.

       What it still catches is narrow and does NOT reduce to the leading guard:
       a non-empty set can still sum to zero — a line at quantity 0, or a
       negative replacement value cancelling a positive one (the filter passes
       negatives deliberately, so corruption stays visible).

       The `replacementItems` guard stays in front of both. It is what the
       Replacement Costs table below is gated on, and dropping it would let a
       rental order with no priced replacement anywhere print this note with no
       table under it to substantiate it. */%>
  <% if (replacementItems.length > 0 && (hasRentals || rTotal > 0)) { %>
  <p>The total replacement cost for all items on your rental order is: <%= it.money.formatCents(rTotal) %></p>
  <% } %>
</section>

<!-- Totals -->
<section id="totals">
  <table>
    <tbody>
      <tr>
        <th scope="row">Subtotal: </th>
        <td><%= it.money.formatCents(totals.subtotal_cents) %></td>
      </tr>
      <% if (totals.discount_amount_cents > 0) { %>
      <tr>
        <th scope="row">Discount: </th>
        <%/* Padded inside the brackets, matching the Discount column in #items —
             the two are the same deduction at two scales and must not look like
             two different conventions. */%>
        <td>( <%= it.money.formatCents(totals.discount_amount_cents) %> )</td>
      </tr>
      <tr>
        <th scope="row">Subtotal after Discount: </th>
        <td><%= it.money.formatCents(totals.subtotal_discounted_cents) %></td>
      </tr>
      <% } %>
      <% totals.taxes.forEach(tax => { %>
      <% if (tax.amount_cents !== 0) { %>
      <tr>
        <%/* The colon belongs to the ROW, not to the rate. It used to sit inside
             the `percent` branch, so the first FLAT tax to reach this block —
             the per-unit water levy — printed "Water Bottle Tax" bare while
             "Subtotal:", "Total:" and every percent tax beside it kept theirs.
             Invisible until now for the documented reason: no fixture carried a
             flat tax, so this arm had never rendered. A flat tax shows no rate
             because its rate is money-per-unit of a unit this block cannot name
             — the row says WHAT was charged, and the items table above says on
             what. */%>
        <th scope="row"><%= tax.name %><% if (tax.type === "percent") { %> <%= tax.rate %>%<% } %>:</th>
        <td><%= it.money.formatCents(tax.amount_cents) %></td>
      </tr>
      <% } %>
      <% }) %>
      <% totals.transaction_fees.forEach(fee => { %>
      <% if (fee.amount_cents !== 0) { %>
      <tr>
        <%/* Same rule as the tax row above — a flat-amount fee is legitimate
             (`calculateTransactionFeeAmount` prices one) and no fixture has one
             yet, so its colon would have gone missing the same way. */%>
        <th scope="row"><%= fee.name %><% if (fee.type === "percent") { %> <%= fee.rate %>%<% } %>:</th>
        <td><%= it.money.formatCents(fee.amount_cents) %></td>
      </tr>
      <% } %>
      <% }) %>
      <tr>
        <th scope="row">Total:</th>
        <td><%= it.money.formatCents(totals.total_cents) %></td>
      </tr>
    </tbody>
  </table>
</section>

<!-- Replacement Costs -->
<% if (replacementItems.length > 0) { %>
<section id="replacement-costs">
  <h1>Replacement Costs</h1>
  <table>
    <thead>
      <tr>
        <th scope="col">Item</th>
        <th scope="col">Unit Cost</th>
        <th scope="col">Sales Tax</th>
        <th scope="col" class="total">Total</th>
        <th scope="col" class="center">Qty</th>
        <th scope="col">Sales Tax</th>
        <th scope="col" class="total">Total</th>
      </tr>
    </thead>
    <tbody>
      <% replacementItems.forEach(item => { %>
      <%
        // One helper, defined once at the top, rather than a second copy of the
        // arithmetic inline here. The two used to be separate and could drift —
        // that is how a per-unit figure and its own line total ended up rounded
        // in different orders.
        const r = replacementLine(item);
      %>
      <tr>
        <%/* Indented by the SAME `componentDepth` the items grid uses — one
             function, so a component cannot read as a top-level line in one
             table and as a child in the other. A component whose parent carries
             no replacement cost is indented under a parent that is absent from
             THIS table; that is the honest rendering, because the nesting is a
             fact about the order rather than about the table. */%>
        <td style="padding-left: <%= componentDepth(item) %>em"><%= item.name %></td>
        <td><%= moneyCell(r.unitCostCents) %></td>
        <td><%= moneyCell(r.unitTaxCents) %></td>
        <td class="total"><%= moneyCell(r.unitTotalCents) %></td>
        <td class="center"><%= numberCell(r.qty) %></td>
        <td><%= moneyCell(r.lineTaxCents) %></td>
        <td class="total"><%= moneyCell(r.lineTotalCents) %></td>
      </tr>
      <% }) %>
      <%/* The last row of the <tbody>, NOT a <tfoot> — deliberately, and against
           the semantics. Browsers repeat a <tfoot> on every printed page by
           design, which is right for a running summary and wrong for this: it is
           a GRAND total, identical on each repeat, so on `long-multi-group` it
           printed at the foot of pages 3, 4 and 5 and each of the first two read
           as if the table ended there at $28,847.87. There is no CSS that
           suppresses only the non-final repeat, and no way to label them apart
           without a mechanism outside the table. templates#74 finding 1. */%>
      <tr class="grand-total">
        <th scope="row" colspan="4">Total Replacement Cost</th>
        <td></td>
        <td><%= moneyCell(rTax) %></td>
        <%/* A GRAND TOTAL, so it prints at zero — `formatCents`, not `moneyCell`.
             A replacement total of $0.00 is a statement about the order; a blank
             cell where the reader expects the summed figure reads as a fault. */%>
        <td class="total"><%= it.money.formatCents(rTotal) %></td>
      </tr>
    </tbody>
  </table>
</section>
<% } %>
  <footer></footer>
</div>
