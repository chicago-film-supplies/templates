<%/* draft draft/quote/c96f356c */%>
<%
const order = it.doc;
const { destinations, items, totals } = order;
const CHICAGO = it.tz("America/Chicago");
const lineItems = items.filter(i => i.type !== "group" && i.type !== "destination");
const hasDiscount = it.orders.orderHasDiscount(lineItems);
const hasRentals = it.orders.orderHasRentals(lineItems);
const hasTax = it.orders.orderHasTax(lineItems);
const replacementItems = lineItems.filter(i => i.price.replacement_cents != null);

// Replacement cost, in integer cents, computed the way CORE computes it.
//
// ## The order of operations is the whole point
//
// This used to be round-then-multiply: a per-unit tax
// (`unitCost * t.rate / 100`) accumulated and then scaled by quantity. Core
// does the opposite in `calculateReplacementTotals` — it multiplies the line out
// FIRST and rounds once, at the line. On dollar floats the two mostly agreed
// and the difference read as rounding noise. On integer cents they diverge
// systematically, and the divergence shows up as a PDF footer that disagrees
// with the order it is rendering.
//
// So the grand totals are no longer hand-rolled at all: `it.orders`
// exposes the real function, and calling it is what makes the footer and the
// stored order the same arithmetic rather than two implementations that happen
// to match. `item.price.taxes` is a `PriceModifier[]` carrying `uid`, `rate`
// and `type`, which is exactly the surface the lookup inside it reads.
//
// ⚠️ The PER-LINE columns below still have no exposed helper —
// `computeItemTaxAmountCents` is deliberately denylisted as a building block,
// and there is no stored per-line replacement field. They are therefore spelled
// out here in the same order core uses, so they sum to the totals by construction.
// It is a duplicated formula and is tracked as such; see the note at the table.
//
// NOTE FOR THE NEXT EDITOR: keep apostrophes OUT of this block. Eta scans for
// the closing tag while tracking string delimiters, and it counts a bare
// single-quote as one even inside a line comment — so an odd number of them
// swallows the close tag and the whole template compiles as a runaway string.
// The failure surfaces as a bad-syntax error several hundred lines away from
// the cause, which is why this note is here rather than in a commit message.
const replacementTaxCatalog = lineItems.flatMap(i => i.price.taxes || []);
const rTotals = it.orders.calculateReplacementTotals(lineItems, replacementTaxCatalog);
const rSubtotal = rTotals.subtotal_cents;
const rTax = rTotals.tax_cents;
const rTotal = rTotals.total_cents;

// One replacement line, in the same order and with the same rounding
// core uses — `× n ÷ d`, divide last, round half away from zero exactly once.
// Half AWAY from zero rather than half up because a negative subtotal is legal
// and a credit must not differ in magnitude from the charge it mirrors.
const replacementLine = (item) => {
  const unitCostCents = item.price.replacement_cents;
  const qty = item.quantity || 0;
  const lineSubtotalCents = Math.round(unitCostCents * qty);
  const taxCentsFor = (subtotalCents, quantity) =>
    (item.price.taxes || []).reduce((sum, t) => {
      if (t.type === "percent") {
        const scaled = subtotalCents * t.rate;
        const magnitude = Math.abs(scaled);
        const rounded = Math.floor((2 * magnitude + 100) / 200);
        return sum + (scaled < 0 ? -rounded : rounded);
      }
      // `flat`: DOLLARS per unit. `t.rate` is a rate and keeps its dollar
      // denomination — this is the one place in the template where a money
      // value is not already cents.
      return sum + Math.round(it.money.toCents(t.rate) * quantity);
    }, 0);
  const lineTaxCents = taxCentsFor(lineSubtotalCents, qty);
  // The per-UNIT column is the line divided back down, not a separately-rounded
  // per-unit computation — deriving it the other way is what made the columns
  // fail to add up to their own footer.
  const unitTaxCents = qty > 0 ? Math.round(lineTaxCents / qty) : 0;
  return {
    unitCostCents,
    qty,
    unitTaxCents,
    unitTotalCents: unitCostCents + unitTaxCents,
    lineTaxCents,
    lineTotalCents: lineSubtotalCents + lineTaxCents,
  };
};
%>
<div id="grid-wrapper">
  <div id="logo">
    <%~ it.logo %>
  </div>
  <section id="bill-to">
    <h1>Quote #<%= order.number %></h1>
    <div><%= order.organization.name %></div>
    <div>
      <span><%= order.organization.billing_address.street %></span>
      <span>, <%= order.organization.billing_address.street2 %></span>
    </div>
    <div>
      <span><%= order.organization.billing_address.city %></span>
      <span>, <%= order.organization.billing_address.region %></span>
      <span> <%= order.organization.billing_address.postcode %></span>
    </div>
    <% if (order.organization.billing_address.country_name != "UnitedStates") { %>
    <div><%= order.organization.billing_address.country_name %></div>
    <% } %>
  </section>
  <section id="cfs">
    <h1>Chicago Film Supplies</h1>
    <div>3100 W Fillmore St, Chicago, IL 60612</div>
    <div>team@chicagofilmsupplies.com</div>
    <div>312.818.3008</div>
  </section>
<section id="details">
  <table>
    <tbody>
      <tr>
        <th scope="row">Date:</th>
        <td><%= it.dateFns.format(it.dateFns.parseISO(it.now), 'MMMM d, yyyy') %></td>
      </tr>
      <tr>
        <th scope="row">Order Number:</th>
        <td><%= order.number %></td>
      </tr>
      <% if (order.reference) { %>
      <tr>
        <th scope="row">Reference:</th>
        <td><%= order.reference %></td>
      </tr>
      <% } %>
      <% if (order.subject) { %>
      <tr>
        <th scope="row">Subject:</th>
        <td><%= order.subject %></td>
      </tr>
      <% } %>
    </tbody>
  </table>
</section>

<table id="destinations">
<% destinations.forEach(function(dest, destIndex) { %>
    <%
    const d = dest.dates || {};
    const legend = it.orders.getDestinationsLegend([dest]);
    const startLabel = legend.start || "Delivery";
    const endLabel = legend.end || "Pickup";
    // Address lines (no contact — contact rides its own column).
    const addrLines = (ep) => {
      if (!ep || !ep.address) return [];
      const a = ep.address;
      return [
        [a.street, a.street2].filter(Boolean).join(', '),
        [a.city, a.region, a.postcode].filter(Boolean).join(', '),
        (a.country_name && a.country_name !== "United States") ? a.country_name : null,
      ].filter(Boolean);
    };
    const contactLine = (ep) => {
      if (!ep || !ep.contact) return "";
      const phone = ep.contact.phones && ep.contact.phones.length > 0 ? ep.contact.phones[0] : null;
      return [ep.contact.name, phone].filter(Boolean).join(' · ');
    };
    %>
  <thead>
    <tr>
    <th scope="col" colspan="2">Dates: </th>
    <th scope="col"><%= startLabel %></th>
    <th scope="col"><%= endLabel %></th>
    </tr>
  </thead>
  <tbody>
    <tr>
    <td class="dates">
      <%= it.dateFns.format(it.dateFns.parseISO(dest.dates.delivery_start), 'EEE M/d/yy') %> - <%= it.dateFns.format(it.dateFns.parseISO(dest.dates.collection_start), 'EEE M/d/yy') %>
    </td>
    <td>
      <%= it.dates.formatChargeDays(dest.dates.days_active).periodLabel %>
    </td>
    <td class="address">
      <% addrLines(dest.delivery).forEach((line, i) => { %><% if (i > 0) { %><br><% } %><%= line %><% }) %>
    </td>
    <td class="address">
      <% addrLines(dest.collection).forEach((line, i) => { %><% if (i > 0) { %><br><% } %><%= line %><% }) %>
    </td>
    </tr>
    <tr>
      <td colspan="2">
      <!-- Charge window — only when it differs from delivery/collection -->
      <% if (!it.orders.isSameAsDeliveryDates(d)) { %>
      <span class="bold">Dates Charged: </span>
      <% } %>
      </td>
      <td class="address"><%= contactLine(dest.delivery) %></td>
      <td class="address"><%= contactLine(dest.collection) %></td>
    </tr>
    <tr>
      <td>
      <% if (!it.orders.isSameAsDeliveryDates(d)) { %>
      <%= it.dateFns.format(it.dateFns.parseISO(dest.dates.charge_start), 'EEE M/d/yy') %> - <%= it.dateFns.format(it.dateFns.parseISO(dest.dates.charge_end), 'EEE M/d/yy') %>
      <% } %>
      </td>
      <td>
        <!-- Charge window — only when it differs from delivery/collection -->
        <% if (!it.orders.isSameAsDeliveryDates(d)) { %>
        <%= it.dates.formatChargeDays(dest.dates.days_charged).periodLabel %>
        <% } %>
      </td>
      <td class="address"><% if (dest.delivery) { %><%= dest.delivery.instructions || "" %><% } %></td>
      <td class="address"><%= dest.collection.instructions || "" %></td>
    </tr>
  </tbody>
<% }) %>
</table>

<!-- Items -->
<% if (lineItems.length > 0) { %>
<section id="items">
  <table>
    <thead>
      <tr>
        <th scope="col">Item Description</th>
        <th scope="col">Type</th>
        <th scope="col">Qty</th>
        <% if (hasRentals) { %>
        <th scope="col">Duration</th>
        <% } %>
        <th scope="col">Unit Price</th>
        <% if (hasDiscount) { %>
        <th scope="col">Discount</th>
        <% } %>
        <th scope="col">Subtotal</th>
        <% if (hasTax) { %>
        <th scope="col">Tax</th>
        <% } %>
        <th scope="col" class="total">Total</th>
      </tr>
    </thead>
    <tbody>
      <% items.forEach(item => { %>
        <% if (item.type === "group") { %>
        <tr>
          <td colspan="<%= 5 + (hasRentals ? 1 : 0) + (hasDiscount ? 1 : 0) + (hasTax ? 1 : 0) %>">
            <strong><%= item.name %></strong>
          </td>
        </tr>
        <% } else if (item.type === "destination") { %>
        <% if (destinations.length > 1) { %>
        <tr>
          <td colspan="<%= 5 + (hasRentals ? 1 : 0) + (hasDiscount ? 1 : 0) + (hasTax ? 1 : 0) %>">
            <%= item.name %>
          </td>
        </tr>
        <% } %>
        <% } else { %>
        <% const isComponent = (item.path?.length ?? 0) > 0; %>
        <tr>
          <td style="<%= isComponent ? 'padding-left: ' + (item.path.length - 3) + 'em' : '' %>">
            <%= item.name %>
            <% if (item.description) { %>
            <br><%= item.description %>
            <% } %>
          </td>
          <td class="capitalize"><%= item.type %></td>
          <td><%= item.quantity %></td>
          <% if (hasRentals) { %>
          <td><%= item.type === "rental" && item.price.chargeable_days ? item.price.chargeable_days + ' days' : '' %></td>
          <% } %>
          <td><%= it.money.formatCents(item.price.base_cents) %></td>
          <% if (hasDiscount) { %>
          <td>
            <% if (item.price.discount) { %>
            <% if (item.price.discount.type === "percent") { %>
            <%= item.price.discount.rate %>%
            <% } else { %>
            <%= it.money.formatCents(item.price.discount.amount_cents) %>
            <% } %>
            <% } %>
          </td>
          <% } %>
          <%
            // `??`, not `||`. A fully-discounted line has
            // `subtotal_discounted_cents: 0`, which is falsy — so `||` fell
            // through and printed the PRE-discount subtotal for exactly the
            // lines where the discount mattered most. The bug was invisible
            // because neither fixture carried a discount until templates#57.
          %>
          <td><%= it.money.formatCents(item.price.subtotal_discounted_cents ?? item.price.subtotal_cents) %></td>
          <% if (hasTax) { %>
          <td>
            <% if (item.price.taxes && item.price.taxes.length > 0) { %>
            <%= it.money.formatCents(item.price.taxes.reduce((sum, t) => sum + t.amount_cents, 0)) %>
            <% } %>
          </td>
          <% } %>
          <td class="total"><%= it.money.formatCents(item.price.total_cents) %></td>
        </tr>
        <% } %>
      <% }) %>
    </tbody>
  </table>
</section>
<% } %>

<section id="information">
  <% if (replacementItems.length > 0) { %>
  <p>The total replacement cost for all items on your rental order is: <%= it.money.formatCents(rTotal) %></p>
  <% } %>
</section>

<!-- Totals -->
<section id="totals">
  <table>
    <tbody>
      <tr>
        <th scope="row">Subtotal: </th>
        <td><%= it.money.formatCents(totals.subtotal_cents) %></td>
      </tr>
      <% if (totals.discount_amount_cents > 0) { %>
      <tr>
        <th scope="row">Discount: </th>
        <td>&minus;<%= it.money.formatCents(totals.discount_amount_cents) %></td>
      </tr>
      <tr>
        <th scope="row">Subtotal after Discount: </th>
        <td><%= it.money.formatCents(totals.subtotal_discounted_cents) %></td>
      </tr>
      <% } %>
      <% totals.taxes.forEach(tax => { %>
      <% if (tax.amount_cents !== 0) { %>
      <tr>
        <th scope="row"><%= tax.name %><% if (tax.type === "percent") { %> <%= tax.rate %>%:<% } %></th>
        <td><%= it.money.formatCents(tax.amount_cents) %></td>
      </tr>
      <% } %>
      <% }) %>
      <% totals.transaction_fees.forEach(fee => { %>
      <% if (fee.amount_cents !== 0) { %>
      <tr>
        <th scope="row"><%= fee.name %><% if (fee.type === "percent") { %> <%= fee.rate %>%:<% } %></th>
        <td><%= it.money.formatCents(fee.amount_cents) %></td>
      </tr>
      <% } %>
      <% }) %>
      <tr>
        <th scope="row">Total:</th>
        <td><%= it.money.formatCents(totals.total_cents) %></td>
      </tr>
    </tbody>
  </table>
</section>

<!-- Replacement Costs -->
<% if (replacementItems.length > 0) { %>
<section id="replacement-costs">
  <h1>Replacement Costs</h1>
  <table>
    <thead>
      <tr>
        <th scope="col">Item</th>
        <th scope="col">Unit Cost</th>
        <th scope="col">Sales Tax</th>
        <th scope="col" class="total">Total</th>
        <th scope="col" class="center">Qty</th>
        <th scope="col">Sales Tax</th>
        <th scope="col" class="total">Total</th>
      </tr>
    </thead>
    <tbody>
      <% replacementItems.forEach(item => { %>
      <%
        // One helper, defined once at the top, rather than a second copy of the
        // arithmetic inline here. The two used to be separate and could drift —
        // that is how a per-unit figure and its own line total ended up rounded
        // in different orders.
        const r = replacementLine(item);
      %>
      <tr>
        <td><%= item.name %></td>
        <td><%= it.money.formatCents(r.unitCostCents) %></td>
        <td><%= it.money.formatCents(r.unitTaxCents) %></td>
        <td class="total"><%= it.money.formatCents(r.unitTotalCents) %></td>
        <td class="center"><%= r.qty %></td>
        <td><%= it.money.formatCents(r.lineTaxCents) %></td>
        <td class="total"><%= it.money.formatCents(r.lineTotalCents) %></td>
      </tr>
      <% }) %>
    </tbody>
    <tfoot>
      <tr>
        <th scope="row" colspan="4">Total Replacement Cost</th>
        <td></td>
        <td><%= it.money.formatCents(rTax) %></td>
        <td class="total"><%= it.money.formatCents(rTotal) %></td>
      </tr>
    </tfoot>
  </table>
</section>
<% } %>
  <footer></footer>
</div>
