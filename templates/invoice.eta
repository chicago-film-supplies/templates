<%
const invoice = it.doc;
const { destinations, items, totals } = invoice;
// EVERY date on this page goes through `it.dates.formatChicago*`, and the zone
// is named nowhere. date-fns resolves BOTH the parse and the format against the
// ambient zone unless each is given `{ in: … }`, stored business datetimes are
// Chicago-offset INSTANTS, and the render container sets no `TZ` — so an
// unpinned pair prints the UTC day and any boundary at or after 19:00 CDT is
// TOMORROW. `@cfs/core/utils/dates` owns that pinning now; a call site that
// spells the zone itself is a second owner of it.
//
// Measured on the order corpus at 56 of 996 rendering a day late; an invoice’s
// `date` and `due_date` are `chicagoStartOfDay`, i.e. midnight, which is the
// worst case for this.

// ── The rows this invoice draws: one core author, not a hand copy ──────────
//
// `it.invoices.documentRenderRows` is what the quote and invoice families used to
// copy by hand, line for line (core#130 row 11). It owns four rules:
//   - a `transaction_fee` is stored in `items[]` but is not a line of the
//     document. It is priced FROM the total, and #totals carries it with its
//     rate, so drawing it in the grid as well prints the same money twice.
//   - a divider is drawn only when a shown line hangs beneath it, so dropping
//     the fee cannot strand a `Transaction Fees` banner over nothing.
//   - `componentDepth` counts LINE ancestors, never a path length, so it is
//     indifferent to how many divider levels exist.
//   - `hide_zero_priced_components` hides a zero-priced COMPONENT and rolls its
//     money onto the nearest visible LINE ancestor, keyed by `path` (a uid
//     repeats within one document), so the grid still reconciles with #totals.
//     A top-level zero-priced line is never hidden.
// The two families differ only in the levels they pass: invoices use
// `INVOICE_ITEM_LEVELS`, because an invoice can bill several orders and so
// nests one level deeper (order, destination, group) than a quote (destination,
// group).
const { lineItems, shownLineItems, shownItems, renderedItems, rolledUp, componentDepth, pathKey } =
  it.invoices.documentRenderRows(items, it.invoices.INVOICE_ITEM_LEVELS, {
    hideZeroPricedComponents: it.params.hide_zero_priced_components === true,
  });

// `it.invoices`, NOT `it.orders`. An invoices→invoices family resolves to
// {dates, money, icons, invoices} and gets no `it.orders` at all, so naming it
// here would throw at render. These three are re-exported from
// `@cfs/core/utils/invoices` for exactly this reason, and core’s
// `tests/template-helpers.test.ts` asserts both namespaces carry the same
// function objects rather than leaving that an assumption.
const hasDiscount = it.invoices.orderHasDiscount(lineItems);
const hasRentals = it.invoices.orderHasRentals(lineItems);
const hasTax = it.invoices.orderHasTax(lineItems);

// SIX unconditional columns — Item Description, Type, Qty, Unit Price,
// Subtotal, Total — plus the three conditionals. 6 to 9, same as the quote,
// because it is the same grid rendered by the same partial.
const itemColumnCount = 6 + (hasRentals ? 1 : 0) + (hasDiscount ? 1 : 0) + (hasTax ? 1 : 0);

// The page’s second alignment edge: the #items column boundary NEAREST THE
// HALF-WAY POINT, rounding left. See styles/quote.css for the derivation — the
// rule is a fact about the shared grid, not about either family.
const addressBoundary = Math.floor((itemColumnCount - 1) / 2);
const addressColumnCount = itemColumnCount - 1;

// A collection leg exists only if something is coming back. Nothing on a sale,
// a service or a surcharge is ever collected, so an invoice with no rental line
// has no return address, contact, end date or duration to print.
//
// ⚠️ Since `hasDeliverableItems` widened below, a FALSE value here is reachable
// only on a SALE-only invoice — goods that go out and never come back. Every
// other rental-less invoice now drops the whole table instead of rendering this
// half of it, so NO fixture exercises the half-collapsed shape any more; it was
// `service-untaxed-fee` until 2026-09-08. See templates#279.
const hasCollection = hasRentals;
const deliverySpan = hasCollection ? addressBoundary : addressColumnCount;
const returnSpan = addressColumnCount - addressBoundary;

// An invoice is read, not reconciled: a numeric cell renders nothing at zero.
// NON-ZERO rather than "> 0" — a flat discount may exceed its own line, so
// `subtotal_discounted_cents` can legitimately go negative and its sign is
// load-bearing.
const numberCell = (n) => n ? n : "";
const moneyCell = (c) => c ? it.money.formatCents(c) : "";
const itemTaxCents = (item) => (item.price.taxes || []).reduce((sum, t) => sum + t.amount_cents, 0);

// A zero money cell on a row that OWES TAX prints an em-dash, not a blank —
// the FLAT tax arm reads the QUANTITY and ignores the subtotal, so a
// zero-priced component can bill real money while its unit price and subtotal
// are both genuinely $0.00. Row-scoped: only a row whose own tax contradicts
// its blank cells gets one.
const moneyCellOn = (c, taxCents) => c ? it.money.formatCents(c) : (taxCents ? "—" : "");

// The Type column exists for ONE job: a product stocked both for sale and for
// rent needs the column to say which this line is.
const DISAMBIGUATED_ITEM_TYPES = new Set(["rental", "sale"]);

// ── Settlement ──────────────────────────────────────────────────────────────
//
// ⚠️ **`payments[]` was DELETED from the invoice on 2026-08-03**, and
// `InvoiceSchema` is a `z.strictObject`, so an invoice cannot re-acquire one.
// The per-settlement journal is a separate `settlements` collection reached by
// `GET /settlements?uid_invoice=…`, and a template only ever receives `it.doc`.
// So this document reports ROLLUPS and cannot itemise them; do not add a
// payments table here, because there is no data behind it.
//
// `?? 0` on every read: `amount_credited_cents` and `amount_void_cents` are
// bare `.optional()` with NO default, so an older invoice legitimately carries
// neither.
const amountPaidCents = totals.amount_paid_cents ?? 0;
const amountCreditedCents = totals.amount_credited_cents ?? 0;
const amountDueCents = totals.amount_due_cents ?? 0;

// Rows appended after Total, formatted HERE rather than in the shared partial:
// a partial that formatted them would be deciding what `?? 0` means for a field
// it cannot see. Credits only appear when there are any — a "$0.00 credited"
// row states an absence as if it were a fact.
const settlementRows = [
  { label: "Amount Paid:", value: it.money.formatCents(amountPaidCents) },
];
if (amountCreditedCents) {
  settlementRows.push({ label: "Credits Applied:", value: it.money.formatCents(amountCreditedCents) });
}
settlementRows.push({ label: "Amount Due:", value: it.money.formatCents(amountDueCents) });

// Does anything on this invoice actually SHIP? Only a `rental` or a `sale` puts
// goods in a van. A `replacement` recovers the cost of something already lost
// or damaged in the customer’s possession; a `service` and a `surcharge` are
// work and money with nothing physical behind them. So an invoice carrying
// neither shipping type has no addresses, contacts or dates to print, and a
// headed table with nothing under it reads as missing data rather than
// inapplicable.
//
// ⚠️ TEMPORARY, AND IT DELIBERATELY LOSES INFORMATION — a stopgap for
// templates#279, which carries the measurement and the open decision. This read
// `some(i => i.type !== "replacement")` until 2026-09-08, so a SERVICE-only
// invoice still rendered the table, and `hasCollection` being `hasRentals` meant
// it rendered the DELIVERY half alone. On prod invoice 2413 — $250 for
// collecting 30 Z Racks on 9/9 — that printed the header `In Store Pickup`, the
// date `Tue 6/23/26` and the address `3100 W Fillmore St`: the June leg on which
// the customer took the racks away from OUR OWN warehouse. It suppressed the 9/9
// date, the site address and the site contact the charge is actually about. Not
// incomplete — the wrong leg, stated confidently, with nothing on the page to
// say so.
//
// A service-only invoice genuinely HAS a date worth printing and this drops it.
// Saying nothing beats saying something false, and that is the whole of the
// argument; the operator states the date in the line’s description meanwhile.
// Fix it by giving a service a leg it can own, not by narrowing this back.
//
// Same two members as `DISAMBIGUATED_ITEM_TYPES` above by coincidence, not by
// shared meaning — that set is about a product stocked both for sale and for
// rent needing the Type column to say which. Do not merge them.
const SHIPPED_ITEM_TYPES = new Set(["rental", "sale"]);
const hasDeliverableItems = shownLineItems.some(i => SHIPPED_ITEM_TYPES.has(i.type));

// Both banners are conditional, and on the same principle: a divider that names
// the only member of its level is noise. A single destination banner names the
// one place everything goes; a single order banner names the one order every
// line came from.
//
// ⚠️ MULTI-ORDER INVOICING IS NOT LIVE. It is a manager feature landing after
// the CRMS cutover, so today every invoice bills exactly one order — measured
// 2026-08-26 across the 200 most recent, `number_orders` is 0 or 1 throughout.
// An unconditional order banner would therefore put a redundant `Order #1004`
// row at the top of every invoice we currently produce. The arm still exists
// and is exercised the moment a second order can be attached.
const showDestinationBanners = destinations.length > 1;
const showOrderBanner = (invoice.number_orders || []).length > 1;
%>
<div id="grid-wrapper" style="--block-3-fraction: calc(<%= addressBoundary %> / <%= addressColumnCount %>)">
<%/* The customer name is COMPOSED from the frozen chain, not read off the
     snapshot's `name` scalar — `organization.path` is what an issued document
     must resolve when it is re-rendered later, and the scalar is being removed
     (`api-cloudrun/.claude/plans/org-name-is-derived.md`). The two agree by
     construction on every document written since `@cfs/core@10.0.0-beta.303`,
     because `buildOrganizationSnapshot` is the sole author of both and already
     sets `name: composeOrgName(path)`. */%>
<%~ await includeAsync("@partials/shared/letterhead.eta", {
     title: `Invoice #${invoice.number}`,
     customer_name: it.organizations.composeOrgName(invoice.organization.path),
     billing_address: invoice.organization.billing_address,
   }) %>

<table id="details">
  <thead>
    <tr>
      <th scope="col">Date:</th>
      <th scope="col">Due Date:</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td><%= it.dates.formatChicagoDate(invoice.date) %></td>
      <%/* An empty cell, not an absent one: under `table-layout: fixed` a short
           row leaves a real trailing gap rather than being absorbed. */%>
      <% if (invoice.due_date) { %>
      <td><%= it.dates.formatChicagoDate(invoice.due_date) %></td>
      <% } else { %>
      <td></td>
      <% } %>
    </tr>
  </tbody>
  <thead>
    <tr>
      <%/* PLURAL, because an invoice can bill several orders — that is the one
           structural difference from the quote's #details block, and it is why
           `number_orders` is an array where an order has a scalar `number`. */%>
      <th scope="col">Order Number<%= (invoice.number_orders || []).length > 1 ? "s" : "" %>:</th>
      <th scope="col">Reference:</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td><%= (invoice.number_orders || []).join(", ") %></td>
      <% if (invoice.reference) { %>
      <td><%= invoice.reference %></td>
      <% } else { %>
      <td></td>
      <% } %>
    </tr>
  </tbody>
</table>

<%/* THE WHOLE TABLE IS RENTAL/DELIVERY FURNITURE, and an invoice that ships
     nothing has none of it — dropping the section outright rather than emptying
     it, the same call the address blocks already make for themselves. One rule
     covers the replacement-only, service-only and surcharge-only invoice; see
     `hasDeliverableItems` above and templates#279 for why the service arm is a
     stopgap rather than the answer. */%>
<% if (hasDeliverableItems && destinations.length > 0) { %>
<%~ await includeAsync("@partials/shared/destinations.eta", {
     u: it.invoices, destinations, addressColumnCount, hasCollection,
     deliverySpan, returnSpan,
   }) %>
<% } %>

<!-- Items -->
<%/* `shownLineItems`, not `lineItems`: an invoice whose only non-divider entry
     is a transaction fee has nothing to put in this grid, and an empty table
     with a header row reads as a rendering fault. */%>
<% if (shownLineItems.length > 0) { %>
<%~ await includeAsync("@partials/shared/items-grid.eta", {
     renderedItems, columnCount: itemColumnCount, hasRentals, hasDiscount, hasTax,
     rolledUp, componentDepth, numberCell, moneyCell, moneyCellOn,
     itemTaxCents, pathKey, DISAMBIGUATED_ITEM_TYPES,
     showDestinationBanners, showOrderBanner,
   }) %>
<% } %>

<!-- EFT Instructions -->
<%/* The invoice's half of the row #totals sits in, and the reason this family
     needs its own section where the quote has #information: an invoice ASKS FOR
     MONEY, so it has to say where the money goes. The quote does not, and must
     not — it is not a payable document.

     STATIC on purpose. These are CFS's own banking details, not a fact about
     the document, so there is nothing on `it.doc` to read them from and no
     branch to take: every invoice is payable to the same account. The
     letterhead's `#cfs` block is the precedent — our own address, phone and
     email are literals there for the same reason.

     Unconditional, including on an invoice already paid in full. A settled
     invoice is still re-rendered and re-sent, and a payment instruction that
     disappears once `amount_due_cents` reaches 0 is missing from exactly the
     copy a customer keeps for their records. */%>
<section id="eft">
  <h2>EFT Instructions:</h2>
  <div>Zelle: team@chicagofilmsupplies.com</div>
  <div>Bank Name: J.P. Morgan Chase · Account Name: Chicago Film Supplies LLC</div>
  <div>ACH Routing: 071000013 · Wire Routing: 021000021</div>
  <div>Account Number: 906160863</div>
</section>

<!-- Totals -->
<%~ await includeAsync("@partials/shared/totals.eta", {
     totals, extraRows: settlementRows,
   }) %>
  <footer></footer>
</div>
