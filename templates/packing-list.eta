<%
// ── What this document IS ───────────────────────────────────────────────────
//
// A packing list states what is being HANDED OVER in one direction, across
// however many orders share the place it is handed over at. Its source is a
// `pick-sheets` document: every open line at one destination, or with one
// organization, across orders (`@cfs/core/schemas/pick-sheet.ts`), folded by
// api-cloudrun `services/pickSheets.ts` and stored NOWHERE.
//
// It is therefore NOT a money document. There is no price, no discount, no tax
// and no total, and no `it.money` call anywhere below. `buildPackingList`
// excludes structural rows, surcharges, transaction fees and services for the
// same reason: none of them is a thing anybody carries.
//
// ⭐ **The grain is MULTI-ORDER, decided 2026-09-04** (templates#150). One
// family renders whichever direction the document declares, reversing the
// 2026-08-27 two-family call — that call rested on "the leg is a property of
// the document", which `PickSheet.leg` has since made literally true as a
// field, so it no longer implies two `git_path`s and two near-identical bodies.
const sheet = it.doc;

// EVERY date on this page goes through `it.dates.formatChicago*`, and the zone
// is named nowhere. date-fns resolves BOTH the parse and the format against the
// ambient zone unless each is given `{ in: … }`, stored business datetimes are
// Chicago-offset INSTANTS, and the render container sets no `TZ` — so an
// unpinned pair prints the UTC day and any boundary at or after 19:00 CDT is
// TOMORROW. `@cfs/core/utils/dates` owns that pinning now; a call site that
// spells the zone itself is a second owner of it.
//
// Measured across all 996 prod orders: 56 carry a delivery or collection
// boundary that renders one day late unpinned.

// `it.pickSheets`, NOT `it.orders`. A pick-sheets→packing_lists family resolves
// to {dates, money, icons, pickSheets} and gets no `it.orders` at all, so naming
// it here would throw at render AND fail the golden gate. The namespace is a set
// of RE-EXPORTS over `utils/orders.ts` rather than reimplementations — core
// `tests/template-helpers.test.ts` asserts they are the same function objects,
// so a copy fails rather than drifts.
const u = it.pickSheets;

// ── Two refusals, both of which produce a WRONG DOCUMENT rather than an ugly
//    one, and neither of which anything upstream can catch ──────────────────
//
// 🔴 **1. A printed packing list must state its direction.**
//
// `PickSheet.leg` is nullable and the pick-sheet SCREEN passes null, because a
// worker standing at a place wants both directions at once. A PAPER is not a
// screen: it accompanies ONE movement. Worse than ambiguous, rendering both legs
// would DOUBLE every rental line — `groupByDestination` returns
// `packing_list_delivery` as rental + sale and `packing_list_collection` as
// rental only, so the two lists overlap exactly on the rentals. A packing list
// that says 4 of something when 2 are moving is the failure this document exists
// to prevent.
//
// Refusing is the safe direction: a render failure is loud and lands on the
// operator who asked for the document, whereas a doubled quantity is discovered
// at a loading dock by someone with no way to check it.
if (sheet.leg === null) {
  throw new Error(
    "packing-list: this document has no leg. `PickSheet.leg` is null, which the pick-sheet " +
      "screen uses to mean BOTH directions — but a printed packing list accompanies one " +
      "movement, and rendering both legs double-counts every rental line (delivery is " +
      "rental + sale, collection is rental only). Build the document with an explicit " +
      "`leg` of \"delivery\" or \"collection\".",
  );
}

// 🔴 **2. This document is PAGED, and a short one is indistinguishable from a
//    small one once a template is running.**
//
// `PickSheet.orders` is *the orders on THIS PAGE*; `order_count`,
// `destination_count` and `quantity` describe the whole SCOPE. That split is
// right for a screen and is a trap for paper: a packing list rendered from a
// default page is silently short, showing a page of orders under a scope-wide
// total that disagrees with them. Core says the caller assembling `doc` must
// walk every page and that "nothing in this namespace can enforce that" — true
// of the namespace, not of the template, which is handed the assembled document
// and can simply check it.
//
// ⭐ **Asserted on `order_count`, NOT on `next_cursor`, and the difference is
// the point.** `next_cursor` is the assembler reporting on its own work, so a
// check against it can only ever agree with whatever the assembler believes;
// `orders.length === order_count` is a property that holds independently of it.
// Pair every fixed-point check with one that does not consult the same oracle.
if (sheet.orders.length !== sheet.order_count) {
  throw new Error(
    `packing-list: this document is SHORT — ${sheet.orders.length} order(s) on the page ` +
      `against ${sheet.order_count} in the scope. A PickSheet is paged by ORDER; the caller ` +
      "must walk every page (following `next_cursor` until it is null) and render the " +
      "assembled document. Printing this page would put a scope-wide unit total over a " +
      "subset of the goods.",
  );
}

// ── The rows, folded once ───────────────────────────────────────────────────

// 🔴 **Per (order, destination) section, NEVER pooled.** `item.path` is a row
// identity WITHIN ONE DOCUMENT, so concatenating the lines of two orders into one
// `groupByDestination` call would collide rows that are not the same row. That
// is why `schemas/pick-sheet.ts` makes the order a level of the NESTING rather
// than a segment of a path, and why a cross-order view groups existing paths and
// never recomputes them.
//
// So the fold runs per leg and the results are only ever concatenated for
// RENDERING, each row still carrying which section it came from.
const legKey = sheet.leg === "collection"
  ? "packing_list_collection"
  : "packing_list_delivery";

// Each packing-list row, paired with the BOOKING its units are counted on.
//
// `buildPackingList` returns bare rows (`uid`, `name`, `quantity`, …) and drops
// the `PickSheetItem` each one came from, so a row cannot name its booking on
// its own. It emits exactly one row per line of the array it is handed that
// has a `uid` and a `rental` or `sale` type, in array order — so the same
// filter over this leg’s entries lines them up index for index. The length
// check makes that pairing fail LOUDLY if the builder’s rule ever moves: a
// row printed beside another row’s unit numbers would put the wrong radios in
// the customer’s hands, which is worse than no document.
//
// `pickSheetLineBooking`, never a `find` on `uid_booking`: it answers only for
// the occurrence that OWNS an aggregate booking, so one booking’s units are
// printed once and not on every line naming it.
//
// The same pairing carries the row’s `depth`, since `buildPackingList` drops
// `path` along with the entry and depth can only be read off the path.
function withBookings(dest, forBuilder, rows, depthOf) {
  const handed = new Set(forBuilder);
  const lineEntries = dest.items.filter(function (entry) {
    const item = entry.item;
    return handed.has(item) && item.uid && (item.type === "rental" || item.type === "sale");
  });
  if (lineEntries.length !== rows.length) {
    throw new Error("packing list: " + rows.length + " rows against " + lineEntries.length + " lines at destination " + dest.uid);
  }
  return rows.map(function (row, i) {
    return Object.assign({}, row, {
      booking: u.pickSheetLineBooking(dest, lineEntries[i]),
      depth: depthOf(lineEntries[i].item),
    });
  });
}

// ── Declared param: hide_zero_priced_components (default true) ──────────────
//
// A zero-priced component is included with its kit at no charge and travels
// inside it, so with the param on its row is dropped and the kit row stands
// for it (owner ruling 2026-10-12, which reverses the earlier call that this
// param would be wrong here). Same predicate as the pick sheet, the quote and
// the invoice: `zero_priced === true` on a COMPONENT, so one order hides the
// same lines on every document.
//
// ⚠️ A COMPONENT is a row sitting under another LINE ITEM, counted as the
// ancestors that resolve to a real line in this leg. Never `path.length`: a
// leg’s items carry its group dividers but not its destination divider, so a
// depth read off the path would call a top-level line a component.
//
// The predicate reads the input and nothing else: no row is kept or moved on
// the strength of another row (owner ruling 2026-10-12, which retired the
// pick sheet’s owner carve-out and its “counted under” label for the same
// reason). Hidden rows are removed BEFORE `buildPackingList`, from the same
// array `withBookings` pairs against, so the row-to-booking pairing stays exact.
const hideZeroPricedComponents = it.params.hide_zero_priced_components === true;

// How deep a line sits UNDER ANOTHER LINE ITEM in one leg — 0 top-level, 1 for
// a kit component, 2 for a component of a component. One function serves both
// the hide predicate above and the row indent below, so a row cannot be a
// component for one purpose and top-level for the other. It is the quote and
// invoice rule (`componentDepth`: ancestors that are line items, never
// dividers) resolved against the leg’s own rows, because a leg’s items carry
// no destination divider for a divider-uid set to subtract. An ancestor absent
// from the leg is not counted, so a collection-leg rental under a sale kit
// renders flush rather than indented under a row the sheet does not print.
function depthIn(dest) {
  const pathKey = function (path) { return path.join(":"); };
  const byPath = new Map();
  dest.items.forEach(function (entry) { byPath.set(pathKey(entry.item.path), entry.item); });
  return function (item) {
    let depth = 0;
    for (let i = 1; i < item.path.length; i++) {
      const ancestor = byPath.get(pathKey(item.path.slice(0, i)));
      if (ancestor && ancestor.type !== "group" && ancestor.type !== "destination") depth++;
    }
    return depth;
  };
}

function hiddenZeroPriced(dest, depthOf) {
  const hidden = new Set();
  if (!hideZeroPricedComponents) return hidden;
  dest.items.forEach(function (entry) {
    if (entry.item.zero_priced === true && depthOf(entry.item) > 0) hidden.add(entry.item);
  });
  return hidden;
}

const sections = sheet.orders.flatMap(function (order) {
  return order.destinations.map(function (dest) {
    const lines = dest.items.map(function (entry) { return entry.item; });
    // `groupByDestination` returns `packing_list_delivery` (rental + sale) and
    // `packing_list_collection` (rental only) per group, so the leg split is
    // DATA rather than markup — the whole reason the `collection_leg` boolean
    // param was dropped. `dest.items` is already this leg at this destination,
    // so what this call really does is apply the rental/sale admission rule.
    const groups = u.groupByDestination(lines, [dest.destination], dest.destination.uid);
    // `flatMap`, not `[0]`. One group is what this call should produce, and a
    // divider-less items array produces a synthetic leading group besides — so
    // indexing would silently DROP lines in exactly the case nobody tests. A
    // packing list that omits a line the customer is owed is the worst outcome
    // available here, so this fails toward listing everything in the section.
    const admitted = new Set(groups.flatMap(function (group) { return group[legKey]; }));
    // 🔴 **The two builders do NOT compose the way their names suggest, and the
    // failure is SILENT.** `packing_list_delivery` / `packing_list_collection`
    // are already stripped of DIVIDERS — `groupByDestination` pushes only rows
    // whose `type` is in its leg set, and `group` is in neither — while
    // `buildPackingList` derives `group_name` by WALKING the array it is given
    // and remembering the last `group` row it passed. Feed one to the other and
    // every `group_name` comes back null: the grid renders, nothing errors, and
    // the section headings a picker navigates by are simply absent.
    //
    // ⭐ So the leg admission is taken as a SET and re-applied to the array that
    // still carries its dividers. Membership is by object IDENTITY, which is
    // exact here because `groupByDestination` pushes the very references it was
    // handed — a uid-keyed set would be wrong, since `item.uid` repeats within
    // one document (18% of prod orders) and `path` is the row identity.
    const depthOf = depthIn(dest);
    const hidden = hiddenZeroPriced(dest, depthOf);
    const forBuilder = lines.filter(function (item) {
      if (hidden.has(item)) return false;
      return item.type === "group" || item.type === "destination" || admitted.has(item);
    });
    return {
      order,
      dest,
      // Expanded, not consolidated: `group_name` is preserved so the group
      // banners below can divide a section the way the order banner divides the
      // document.
      rows: withBookings(dest, forBuilder, u.buildPackingList(forBuilder), depthOf),
      // Whether anything at THIS leg is coming back. `orderHasRentals` answers
      // truthfully on a fulfillment-shaped line (`rental` is a
      // `FULFILLMENT_LINE_ITEM_TYPES` member) — the two money helpers in the
      // shared sub-interface, `orderHasDiscount` and `orderHasTax`, would not,
      // which is why nothing here calls them.
      hasRentals: u.orderHasRentals(lines),
    };
  });
});

// ── Per-product totals across the sheet ─────────────────────────────────────
//
// A product that prints on more than one row (a kit component and a standalone
// line, the same item in two groups, two destinations, two orders) gets a Qty
// column of its own naming how many the WHOLE SHEET carries, so the person loading it
// can count the pile once rather than add rows up (owner, 2026-10-14).
//
// Keyed on the product `uid`, the same key `consolidateItems` uses, and summed
// from the PRINTED rows’ own line quantities: a hidden zero-priced component is
// not on the page, so it is not in a total the page asks the reader to check.
// Never from a booking — see the NOT-rendered list below.
const productTotals = new Map();
sections.forEach(function (section) {
  section.rows.forEach(function (row) {
    const seen = productTotals.get(row.uid) || { rows: 0, quantity: 0 };
    seen.rows += 1;
    seen.quantity += row.quantity;
    productTotals.set(row.uid, seen);
  });
});

// ── The facts this document states ──────────────────────────────────────────

// The direction, in the words a person uses for it. Not a lookup table in core:
// there are two members and this is WORDING, which is the business of a template
// — the same call `receipt.eta` makes about movement-type labels.
const legLabel = sheet.leg === "collection" ? "Collection" : "Delivery";

// ⚠️ The customer name is GUARDED, and null is an ANSWER rather than missing
// data. A destination-scoped sheet spans whatever is open at one place, and a
// shared stage legitimately holds two productions at once — which is exactly the
// case the per-order banners exist for. Printing the first organization in the
// letterhead would put one customer's name on another's goods, so the sheet
// names a customer only when it has exactly one.
//
// ⭐ Read off `sheet.organizations`, the distinct set across EVERY page rather
// than off the page, so this cannot become "one customer" on a document that was
// assembled correctly but happens to begin with one.
// core#93: the sheet carries the CHAIN, not a pre-joined name, so the label is
// composed here by the same `composeOrgName` that authors every other account
// label. `organization_path` is null exactly when the uid is — an unattributed
// order, which is "no customer" rather than "a customer with no name".
const customerName = sheet.organizations.length === 1
  ? it.organizations.composeOrgName(sheet.organizations[0].organization_path ?? [])
  : null;

// Both banner gates follow the same principle — a divider that names the only
// member of its level is noise — and each is computed from what its own level
// actually contains, which is the caller's job and not the grid's.
const showOrderBanner = sheet.orders.length > 1;
const showDestinationBanners = sections.length > 1;

// A serialized row names its UNIT NUMBERS as ranges, so the customer can see
// which radios they were handed (api-cloudrun#1230). Numbers only, never
// serials (owner, 2026-10-08).
//
// They print as a DESCRIPTION line under the row, full width, the way the
// quote prints an item description, rather than in a Stock column (owner,
// 2026-10-12). A column held one or two cells of text on a page of bulk lines
// and pushed Qty away from Type; a description line costs nothing on a row
// that has no units.
//
// ⭐ BOTH the `prepped` and the `out` sets, each labelled (owner, 2026-10-08):
// a list printed mid-prep must say which units are packed and which have
// already gone. The other unit buckets (`returned`, `lost`, `damaged`,
// `cleaning`, `maintenance`) are custody AFTER the movement this paper travels
// with, and stay off it. Labels come from core’s declaration, the same words
// the pick sheet prints.
//
// The line always opens “Units:”, and a row whose booking has named no units
// says so: “Units: unassigned” (owner, 2026-10-12). That covers `units` null
// (an UNTRACKED booking, or a fixture captured before core beta.635) and a
// tracked booking with nothing prepped or out yet. “Units” rather than the old
// column’s “Serialized”: the line is about which units, not the stock method.
//
// ⚠️ A row with NO booking prints no line. `pickSheetLineBooking` answers only
// for the occurrence that owns an aggregate booking, so a second occurrence’s
// units are printed on the owner’s row; “unassigned” there would be false.
//
// The sets are joined with ", ", the same separator the ranges inside a set
// use; the bucket label is what marks where one set ends and the next begins.
const PACKED_UNIT_BUCKETS = ["prepped", "out"];
function unitText(row) {
  if (row.stock_method !== "serialized" || !row.booking) return "";
  const units = row.booking.units;
  const sets = units
    ? PACKED_UNIT_BUCKETS
      .filter(function (key) { return units[key] && units[key].length > 0; })
      .map(function (key) { return u.BOOKING_BREAKDOWN_LABELS[key] + " " + u.formatUnitRanges(units[key]); })
    : [];
  return "Units: " + (sets.length > 0 ? sets.join(", ") : "unassigned");
}

// FOUR columns — Item Description, Type, Qty, and the per-product sheet total
// (“(15 of 38 total)”, owner 2026-10-14), which is blank on a product that
// prints once. This grid is NOT
// `partials/shared/items-grid.eta`: that partial is 6 to 9 columns of money
// (Unit Price, Discount, Subtotal, Tax, Total), and a packing list has none of
// them. This family shares the letterhead, the destinations table, the footer
// and the stylesheet, and nothing else.
const itemColumnCount = 4;

// The second alignment edge of the page: the #items column boundary NEAREST THE
// HALF-WAY POINT, rounding left. Same derivation as the quote, the invoice and
// the receipt (see styles/base.css) — a fact about the shared page grid rather
// than about any one family, and what keeps #details stopping on a real column
// of the table below it.
//
// ⚠️ Derived from the THREE item columns, not four. The total column is
// appended after Qty and must not move the edge #details and #destinations
// sit on; counting it would shift that edge from one half to one third.
const addressColumnCount = 3 - 1;
const addressBoundary = Math.floor(addressColumnCount / 2);

// The destinations table draws every leg on the sheet in one block, so its
// collection side is on when ANY leg has something coming back — the same
// question the quote asks of its own destinations, asked at the grain of this
// document. A collection sheet is rentals by construction and answers true anyway.
const hasCollection = sections.some(function (section) { return section.hasRentals; });
const deliverySpan = hasCollection ? addressBoundary : addressColumnCount;
const returnSpan = addressColumnCount - addressBoundary;

// ── What this template deliberately does NOT render ─────────────────────────
//
// Stated rather than left to be rediscovered, because each looks like an
// omission and each is a decision:
//
// • Any per-line quantity derived from `PickSheetItem.uid_booking`. A booking is
//   aggregate per (order, product, destination), so a priced principal beside
//   its zero-priced accessories, a `splitItem`, or a product appearing both
//   standalone and as a kit component all name the SAME booking. Summing it per
//   line is N× wrong. `it.pickSheets` ships no quantity helper for exactly this
//   reason. Each row prints its own line `quantity`; the only derived number is
//   the per-product suffix above, summed from printed line quantities.
//
// • A unit total across DIFFERENT products — not per destination, not for the
//   sheet. Dropped on the owner’s instruction (2026-10-12), matching the pick
//   sheet. The per-product suffix is a different number (one product, every
//   row it prints on) and was asked for separately (2026-10-14).
//
//   `PickSheetDestination.quantity` and `PickSheet.quantity` are still on the
//   document and are deliberately not read.
//
// • `PickSheetDestination.breakdown` and `PickSheetBooking.shortage` — custody
//   buckets and unfilled units. Both are real and both are internal: a shortage
//   is a thing to resolve BEFORE the goods leave, not a line on the paper that
//   travels with them. The pick-sheet screen is where that belongs.
//
// • `PickSheet.gate` — which crew/counter slice the sheet was drawn for. It
//   narrows what is on the page and is already implied by the page; naming it
//   would put an internal dispatch concept on a customer-facing document.
//
// • (Retired 2026-10-12.) This list used to refuse `hide_zero_priced_components`
//   on the grounds that a zero-priced kit accessory still has to travel. The
//   owner ruled otherwise: it travels INSIDE its kit, so the kit row stands for
//   it, and the param is now declared above, default on.
//
// • Any signature line. A hand-off signature is a real thing to want here, and it
//   is a decision about the WORKFLOW — who signs, for what, and whether an
//   unsigned packing list means anything — rather than a layout choice, so it is
//   not invented here. `receipt.eta` declines it for the same reason.
%>
<div id="grid-wrapper" style="--block-3-fraction: calc(<%= addressBoundary %> / <%= addressColumnCount %>)">
<%/* ⚠️ The letterhead takes a NAME, not an organization, and this family is the
     THIRD population reaching it. An order and an invoice carry a frozen
     `DocumentOrganizationSnapshot` whose `path` composes a name; a movement
     session carries `{uid, name}`; a pick sheet carries a SET of `{uid, name}` —
     so there is no expression the partial could evaluate that is right for all
     three, and each caller states how it got a name instead.

     `billing_address` is an explicit null: a pick sheet is a movement document
     and carries no billing address anywhere in its schema. Passing null says
     that, where omitting the prop would leave it undefined and read as an
     oversight. */%>
<%~ await includeAsync("@partials/shared/letterhead.eta", {
     title: `Packing List — ${legLabel}`,
     customer_name: customerName,
     billing_address: null,
   }) %>

<p id="scope">
  <%/* The sentence that stops a delivery note being read as a collection note.
       `PickSheet.leg` is STAMPED on the document rather than re-derived at
       render, which is what makes a packing list a record: re-rendering it weeks
       later must not silently change direction because custody moved underneath
       it. */%>
  <strong><%= legLabel %></strong> —
  <%/* Three arms, one per `PickSheetScope.kind`, and the third is NOT a
       near-duplicate of the others. `order` is the DEGENERATE scope
       (`@cfs/core@10.0.0-beta.333`, api-cloudrun#821): the sheet is ONE
       shipment, so "everything at" reads as a place and "all open work for"
       claims a roll-up this document is not. The label is the ORGANISATION's
       either way — the order itself is named on its own banner below. */%>
  <%= sheet.scope.kind === "order"
    ? "for"
    : sheet.scope.kind === "organization"
    ? "all open work for"
    : "everything at" %>
  <strong><%= sheet.scope.name %></strong>
</p>

<table id="details">
  <thead>
    <tr>
      <th scope="col">Printed:</th>
      <th scope="col">Order<%= sheet.order_count === 1 ? "" : "s" %>:</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <%/* `it.now` is `chicagoNowIso()` and sits on the same footing as every
           stored instant — unpinned it dated every quote rendered after 19:00
           Chicago as tomorrow. A packing list is printed at the moment of
           picking, which is exactly when an evening boundary is crossed. */%>
      <td><%= it.dates.formatChicagoDateTime(it.now) %></td>
      <%/* The SCOPE counts, which by the refusal above are also the page counts.
           `order_count` rather than `orders.length` deliberately: they are equal
           here by assertion, and naming the scope-wide one keeps the document
           saying what it MEANS rather than what it happens to hold. */%>
      <%/* 🔴 The NUMBER when there is exactly one order, not the count.
           `showOrderBanner` is `orders.length > 1`, so a single-order sheet
           emits no order banner — and before this it named its order NOWHERE:
           the letterhead carries the customer, this cell carried the literal
           "1", and "Order: 1" reads as order #1 besides. An `order`-scoped
           packing list is single-order by construction, so that gap was the
           whole document failing to say which order it accompanies. */%>
      <td><%= sheet.order_count === 1 && sheet.orders[0]
        ? `#${sheet.orders[0].number}`
        : sheet.order_count %></td>
    </tr>
  </tbody>
</table>

<%/* ONE destinations table for the whole sheet, drawn by the shared partial —
     the same table the quote and the invoice draw, so a customer reading a
     packing list and the quote it came from sees one company's paperwork.

     `dest.destination` IS a `DocDestination` ({uid, dates, delivery, collection,
     customer_collecting, customer_returning, jurisdiction}), byte-identical to
     the one on its own order, so these pass straight through rather than being
     reshaped.

     ⚠️ A shared partial never NAMES a util namespace: `u` is handed in, and
     `u.getDestinationsLegend` / `u.isSameAsDeliveryDates` are the same function
     objects `it.orders` would have resolved to for an orders-source family. */%>
<%~ await includeAsync("@partials/shared/destinations.eta", {
     u,
     destinations: sections.map(function (section) { return section.dest.destination; }),
     addressColumnCount, hasCollection,
     deliverySpan, returnSpan,
   }) %>

<!-- Items -->
<section id="items">
  <table>
    <thead>
      <tr>
        <th scope="col" class="wide">Item Description</th>
        <th scope="col" class="type">Type</th>
        <th scope="col" class="qty">Qty</th>
        <th scope="col" class="sheet-total"></th>
      </tr>
    </thead>
    <tbody>
      <%/* The banner spans this table exactly, from the same number the header is
           built from and the alignment edge above is derived from — a banner that
           disagreed with the header would take that edge with it. */%>
      <% const bannerSpan = itemColumnCount; %>
      <% let lastOrderUid; %>
      <% sections.forEach(function (section) { %>
        <% if (showOrderBanner && section.order.uid !== lastOrderUid) { %>
          <% lastOrderUid = section.order.uid; %>
        <%/* 🔴 The order banner is SAFETY, not decoration. A destination-scoped
             sheet spans whatever is open at one place, and a shared stage holds
             two productions at once — so a picker reading a mis-attributed row
             hands one production's gear to another. The organization rides the
             banner for the same reason, and only when the sheet actually spans
             customers (otherwise the letterhead already said it once). */%>
      <tr class="order-banner">
        <td class="wide" colspan="<%= bannerSpan %>">
          <strong>Order #<%= section.order.number %></strong><%= section.order.subject ? ` — ${section.order.subject}` : "" %><% const orderOrgName = it.organizations.composeOrgName(section.order.organization.organization_path ?? []); %><% if (customerName === null && orderOrgName) { %> · <%= orderOrgName %><% } %>
        </td>
      </tr>
        <% } %>
        <% if (showDestinationBanners) { %>
      <tr class="destination-banner">
        <td class="wide" colspan="<%= bannerSpan %>">
          <%/* `PickSheetDestination.name` is the destination DIVIDER's name —
               what the operator called this section on the order. No unit
               count beside it: see the NOT-rendered list. */%>
          <%= section.dest.name %>
        </td>
      </tr>
        <% } %>
        <% let lastGroup; %>
        <% section.rows.forEach(function (row) { %>
          <%/* Group banners come from `group_name`, which `buildPackingList`
               preserves in its expanded (non-consolidated) form. Emitted on
               CHANGE rather than by grouping the rows first: the builder already
               returns them in depth-first document order, and re-grouping would
               be a second ordering authority that can disagree with the first. A
               null group is a real member — an item sitting directly under the
               destination — and is left unbannered rather than given an invented
               heading.

               `lastGroup` is re-declared per SECTION, so the same group name in
               two destinations banners twice. That is correct: they are different
               sections of different work, not a repeat. */%>
          <% if (row.group_name && row.group_name !== lastGroup) { %>
      <tr class="group-banner">
        <td class="wide" colspan="<%= bannerSpan %>"><%= row.group_name %></td>
      </tr>
          <% } %>
          <% lastGroup = row.group_name; %>
          <% const units = unitText(row); %>
      <%/* `item-end` marks the LAST row of an item, the description line when
           there is one, so the light rule falls under the whole item rather
           than between a row and its own units. */%>
      <tr class="item<%= units ? "" : " item-end" %>">
        <%/* Indented 1em per level under a line item, the same rule and unit as
             the quote and invoice items grid. Banners are never indented. */%>
        <td style="padding-left: <%= row.depth %>em"><%= row.name %></td>
        <td class="capitalize"><%= row.type %></td>
        <% const productTotal = productTotals.get(row.uid); %>
        <td class="qty"><%= row.quantity %></td>
        <td class="sheet-total"><% if (productTotal.rows > 1) { %><strong><em>(<%= row.quantity %> of <%= productTotal.quantity %> total)</em></strong><% } %></td>
      </tr>
          <% if (units) { %>
      <tr class="item-description item-end">
        <td class="wide" colspan="<%= bannerSpan %>" style="padding-left: <%= row.depth %>em"><%= units %></td>
      </tr>
          <% } %>
        <% }) %>
      <% }) %>
    </tbody>
  </table>
</section>

<% if (sheet.missing_order_uids.length > 0 || sheet.notice) { %>
<%/* 🔴 SURFACED, never dropped. `missing_order_uids` names orders the scope
     admits whose fulfillment document could not be read — `bookings` and the
     projection disagree, which is a finding
     (`api-cloudrun/scripts/audit-fulfillment-projection.ts`) rather than a
     display problem. The person holding this paper is the only one positioned to
     notice that the goods in front of them are short, so printing it quietly
     would defeat the point of the field existing.

     `notice` is set only when the page was clipped, and by refusal 2 above a
     clipped page never reaches here — it is printed anyway because a notice the
     schema can set and the document never shows is a silent channel, and this one
     costs a paragraph. */%>
<section id="exceptions">
  <% if (sheet.missing_order_uids.length > 0) { %>
  <p>
    <strong>Incomplete:</strong>
    <%= sheet.missing_order_uids.length %>
    order<%= sheet.missing_order_uids.length === 1 ? "" : "s" %>
    in this scope could not be read and <%= sheet.missing_order_uids.length === 1 ? "is" : "are" %>
    NOT listed above. Do not treat this sheet as the complete picture until that is resolved.
  </p>
  <% } %>
  <% if (sheet.notice) { %>
  <p><strong>Notice:</strong> <%= sheet.notice %></p>
  <% } %>
</section>
<% } %>
</div>
